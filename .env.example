# Export these variables before starting; server.py does not auto-load dotenv.
LIVO_PORT=8085
LIVO_STATE_DIR=./var
# Optional: comma-separated HTTPS public origins, without trailing slashes.
LIVO_ORIGINS=https://livo.example.com
# Optional: directory containing ip2region_v4.xdb and ip2region_v6.xdb.
# LIVO_GEO_DIR=./var/geo
# Enable only if Cloudflare overwrites and validates location headers.
LIVO_CF_LOCATION_HEADERS=0
